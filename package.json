{
  "name": "g2-pokemon-showdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pokemon battle game for Even Realities G2 smart glasses",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start:sim": "./scripts/start-sim.sh",
    "start:glasses": "./scripts/start-glasses.sh",
    "qr": "node node_modules/@evenrealities/evenhub-cli/main.js qr",
    "pack": "npm run build && evenhub pack app.json ./dist --output pokemon-showdown.ehpk",
    "fix-data": "node scripts/fix-data.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.15",
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@pkmn/randoms": "0.10.11",
    "@smogon/calc": "0.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
